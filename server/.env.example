# Port for the Node.js API server
PORT=5000

# MongoDB Atlas Connection URI
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas details:
# Example: mongodb+srv://myuser:mypassword@cluster0.abcde.mongodb.net/lumina_read?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/lumina_read?retryWrites=true&w=majority

# Allowed CORS client origin (for book.mehaxan.com)
CLIENT_ORIGIN=https://book.mehaxan.com,http://localhost:5173

# Node Environment
NODE_ENV=production
